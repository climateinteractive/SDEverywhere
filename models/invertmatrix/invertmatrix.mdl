{UTF-8}
product[fromSSrange,toSSrange]=
	SUM(A inverse[fromSSrange,ssRange!]*matrix A[ssRange!,toSSrange])
	~	dmnl
	~		|

ssRange:
	s1,s2
	~	
	~		|

toSSrange<->
	ssRange
	~	
	~		|

fromSSrange<->
	ssRange
	~	
	~		|

matrix A[s1,ssRange] = 1,2 ~~|
matrix A[s2,ssRange] = 3,4
	~	dmnl
	~		|

A inverse[fromSSrange,toSSrange]=
	INVERT MATRIX(matrix A[fromSSrange,toSSrange],2)
	~	dmnl
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

