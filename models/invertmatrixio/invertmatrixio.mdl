{UTF-8}
Computed TLIM[Source ISIC Code, Target ISIC Code]=
	INVERT MATRIX(TIOT Minus Identity Matrix[Source ISIC Code,Source ISIC Code],ELMCOUNT\
		(ISIC Code))
	~	
	~		|

Identity Matrix for ISIC Codes[Source ISIC Code,Target ISIC Code]=
	IF THEN ELSE(
	  Source ISIC Code = Target ISIC Code,
	
	  1,
	
	  0
	)
	~	
	~		|

