TIOT Minus Identity Matrix[Source ISIC Code, Target ISIC Code]=
	Identity Matrix for ISIC Codes[Source ISIC Code, Target ISIC Code]
	-TIOT Total Input Output Table[Source ISIC Code,Target ISIC Code]
	~	
	~		|

TIOT Total Input Output Table[Source ISIC Code,Target ISIC Code]=
	GET DIRECT CONSTANTS(
	   'InputData/TIOT/TIOT.csv',
	   ',',
	   'B2'
	)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2026
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 2025
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

