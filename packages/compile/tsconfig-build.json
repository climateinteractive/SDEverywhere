// This contains the TypeScript configuration used to emit type declarations for
// the public API.  Note that this package publishes its JavaScript sources directly,
// so this only emits `.d.ts` files (generated from the JSDoc comments in the sources)
// and does not transpile any code.
{
  "extends": "./tsconfig-base.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    // The test files are not part of the published API, so they don't need declarations
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.js"]
}
